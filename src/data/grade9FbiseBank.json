        "chapter": "Tissues, Organs and Organ Systems",
        "chapterNumber": 4,
        "topic": "Epithelial Tissues",
        "question": "Which type of animal epithelial tissue consists of a single layer of flattened, scale-like cells specialized for rapid passive diffusion in pulmonary alveoli and blood capillaries?",
        "options": {
          "A": "Simple squamous epithelium",
          "B": "Stratified columnar epithelium",
          "C": "Pseudostratified ciliated epithelium",
          "D": "Transitional epithelium"
        },
        "correctAnswer": "A",
        "explanation": "Simple squamous epithelium features thin, flat cells that offer minimal diffusion distance, lining capillary walls and lung alveoli.",
        "difficulty": "medium",
        "verified": true,
        "source": "curriculum-bank",
        "createdAt": "2026-08-23T18:00:00.000Z"

# ==============================================================================
# Scholario - Environment Configuration Template (.env.example)
# Copy this file to .env.local (or configure secrets in your deployment provider).
# NEVER commit real secret values to version control.
# ==============================================================================

# Database Connection (PostgreSQL direct or pooler URI)
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Supabase API Configuration
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_token_here

# Frontend / Vite Client Exposure (prefix with VITE_)
VITE_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
VITE_DATABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_DATABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@scholario.app
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare R2 / AWS S3 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=scholario-notes
R2_EXAM_SUBMISSIONS_BUCKET=scholario-exam-submissions
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_BUCKET=scholario-notes
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

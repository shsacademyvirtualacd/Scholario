# ==============================================================================
# Scholario LMS — Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit populated .env, .env.local, or secrets into git version control.
# - Use placeholders only in this template.
# ==============================================================================

# ─── Server & Application Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Supabase Backend & Database (PostgreSQL) ─────────────────────────────────
# Direct PostgreSQL connection string (Postgres credentials / connection pooler)
# Format: postgresql://postgres.[project-ref]:[db-password]@[pooler-host]:5432/postgres
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase API Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Vite Frontend Client Environment (Exposed to browser build) ──────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional Client Fallback Aliases (if used interchangeably)
VITE_DATABASE_URL=
VITE_DATABASE_ANON_KEY=

# ─── Google Gemini AI API ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Web Push Notifications (VAPID) ──────────────────────────────────────────
# Generated via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scholario.app

# Edge Function Cron Secret (Secures scheduled triggers)
CRON_SECRET=

# ─── Email Dispatch (Resend API) ──────────────────────────────────────────────
RESEND_API_KEY=

# ─── Cloudflare R2 / AWS S3 Compatible Object Storage ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=scholario-notes
R2_EXAM_SUBMISSIONS_BUCKET=scholario-exam-submissions

# Legacy / S3 Aliases (if applicable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=